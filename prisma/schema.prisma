model QuoteLibrary {
  id           String   @id @default(uuid())
  text         String
  attribution  String?
  org_scope    String   @default("ALL") // all | primerica
  cfe_cleared  Boolean  @default(false)
  tags         String[]
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
