// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Account security & incident telemetry (§16.4, §16.7)
// ═══════════════════════════════════════════════════════════════════════

// Append-only; no update path is exposed by design (mirrors AuditEntry's immutability posture).
model SecurityEvent {
  id                        String   @id @default(uuid())
  user_id                   String?  // nullable for platform-level events
  type                      String   // login_success|login_failure|mfa_challenge|password_reset|session_revoked|rate_limited|suspected_takeover|breach_incident
  ip_hash                   String?
  device_fingerprint_hash   String?
  severity                  String   @default("INFO") // INFO | WARNING | CRITICAL
  created_at                DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at])
  @@index([type, created_at])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — State insurance licensing state machine (§16.5, T-13)
// ═══════════════════════════════════════════════════════════════════════

// One row per (user, jurisdiction) pair (§16.5 "rules parameterized per state"). Absence of a
// row for a jurisdiction means UNLICENSED there by fail-closed default
// (src/services/compliance/licensing) — never inferred otherwise. `state` follows this file's
// convention for entity-specific, config-shaped vocabularies (see header note): a String column
// with the allowed values enumerated below. The four legal values and their legal transitions are
// enforced in application code (src/services/compliance/licensing/licensing-state-machine.ts),
// not by this column's type.
model LicensingRecord {
  id              String    @id @default(uuid())
  user_id         String
  jurisdiction    String    // two-letter US state postal code, e.g. "TX"
  state           String    // UNLICENSED | PRE_LICENSING | LICENSED | LICENSE_EXPIRED (§16.5)
  license_number  String?   // encrypted at rest at the application layer; IBA/POL identifier
  issued_at       DateTime? @db.Timestamptz(6)
  expires_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([user_id, jurisdiction])
  @@index([user_id])
  @@index([jurisdiction, state])
}

// Append-only transition history for LicensingRecord (mirrors SecurityEvent's immutability
// posture above). The full immutable/signed audit store is T-10's build; this table is the
// durable who/when trail for licensing specifically, written by
// src/services/compliance/licensing/licensing-service.ts on every legal transition. A T-10 sink
// can additionally mirror these into the signed store without this table changing shape.
model LicensingStateEvent {
  id           String   @id @default(uuid())
  user_id      String
  jurisdiction String
  from_state   String   // the state transitioned FROM (§16.5 vocabulary)
  to_state     String   // the state transitioned TO
  action       String   // START_PRE_LICENSING | OBTAIN_LICENSE | EXPIRE_LICENSE | RENEW_LICENSE
  actor_id     String   // who performed the transition (rep self, admin, or a system job)
  actor_role   String?
  reason       String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at])
  @@index([jurisdiction, created_at])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Breach notification & incident response (§16.7, T-15)
// ═══════════════════════════════════════════════════════════════════════

// The dedicated append-only incident log (T-15, build-brief item 4). One row per lifecycle
// event (DECLARED | TRIAGED | CONTAINED | NOTIFIED | RESOLVED, §16.7's detected -> triaged ->
// contained -> notified -> resolved runbook) — there is deliberately no separate "Incident" header
// row with a mutable `status`/`severity` column: current state (severity, lifecycle position,
// breach classification, the GDPR Art. 33 72-hour clock, notification detail) is always a
// *projection* folded from this ordered log at read time
// (src/services/security/incident/incident-projection.ts), never a value that gets UPDATEd in
// place. `kind` follows this file's convention for entity-specific, config-shaped vocabularies
// (see the header note above): a String column with the allowed values enumerated here rather than
// a Prisma enum, so the vocabulary can grow without a migration. `payload` carries every
// kind-specific detail (declare-time classification + evidence event ids; triage notes/breach-class
// decision; containment actions; notification parties/data-categories/method; resolution root
// cause) — see src/types/incident.ts for the full per-kind payload shapes. Every row here is also
// mirrored into T-10's hash-chained AuditEntry store (domain: 'account_security') via
// src/services/security/incident/incident-audit-sink.ts for a second, cryptographically
// tamper-evident copy of the same evidence.
model IncidentEvent {
  id          String   @id @default(uuid())
  incident_id String
  /// Monotonic per-incident append order (1 = the DECLARED row). Assigned by IncidentService,
  /// never by the caller — mirrors AuditEntry.sequence's role in the T-10 store.
  sequence    Int
  kind        String   // DECLARED | TRIAGED | CONTAINED | NOTIFIED | RESOLVED
  actor_id    String?  // null on a system-declared (SecurityEvent-correlation) DECLARED row
  actor_role  Role?
  payload     Json
  occurred_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([incident_id, sequence])
  @@index([incident_id, occurred_at])
  @@index([kind, occurred_at])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — WP03 Harvest Method & readiness engine (§8.1-§8.2, T-26)
// ═══════════════════════════════════════════════════════════════════════

/// The six Qualities Flip clusters (master-spec §8.1 — this is the section that GOVERNS over the
/// blueprint's five-quality flip per the uiux §5.4 reconciliation note). A closed Prisma enum, not
/// a config string, so a future edit can never silently drift the count away from six.
enum QualityCluster {
  COMMUNITY_HUB
  RISING_ACHIEVER
  NATURAL_TEACHER
  STEADY_BUILDER
  HEART_OF_GOLD
  QUIET_INFLUENCER
}

/// §8.2 priority tiers. EXCLUDED is a distinct, always-explicit tier (never merely "absent from the
/// queue") so the exclusion is a value the code has to actively filter, not a state a future bug can
/// forget to check for.
enum ReadinessTier {
  A
  B
  SLOW_BURN
  EXCLUDED
  // T-29R2 (WP03 gate remediation follow-up, §7.6 "needs info" pattern mirrored for §8.2
  // eligibility): a REGULATED rep's contact with an UNKNOWN (null) jurisdiction — distinct from
  // EXCLUDED (a CONFIRMED-unlicensed jurisdiction, unchanged). Held out of the §8.3 action queue
  // (can't draft compliant outreach without knowing the state) but SURFACED in the ritual-review
  // view as a remediable data-completion prompt, never silently dropped and never conflated with a
  // confirmed exclusion. See eligibility.ts `checkJurisdictionExclusion` and
  // prioritized-queue.service.ts's tier-assignment for the full precedence.
  NEEDS_JURISDICTION
}

/// One row per rep — the three-layer method's own progress state (§8.1). Deliberately its own
/// additive table, never a new column on `User` (WP01-owned): every layer here is UNIVERSAL for
/// every organization (§8 preamble, §17.1) — this table carries no Primerica-only column. Primerica
/// overlay context (rank, solution number) is read live from `User` at render time by
/// `primerica-overlay.ts`, never duplicated here.
model HarvestMethodState {
  id                               String    @id @default(uuid())
  user_id                          String    @unique
  vault_count_at_blank_canvas      Int?      // count shown at Layer-1 entry (number only, no names, §8.1)
  blank_canvas_completed_at        DateTime? @db.Timestamptz(6)
  blank_canvas_seed_count          Int?      // size of the curated seed list produced
  blank_canvas_soft_gate_confirmed Boolean   @default(false) // rep confirmed "stop at N<5" (§8.1 soft gate)
  qualities_flip_selected_clusters QualityCluster[] @default([]) // the 2-3 clusters the rep picked as resonant (empty = not yet chosen)
  qualities_flip_completed_at      DateTime? @db.Timestamptz(6)
  background_matching_completed_at DateTime? @db.Timestamptz(6)
  created_at                      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([user_id])
}

/// One row per (rep, contact) — everything the three layers capture about a single seed contact,
/// plus the computed HIDDEN readiness score (§8.1 Layer 3, §8.2). This is WP03's own additive
/// table; it never adds a column to the WP02-owned `Contact` model. `readiness_score` is the named
/// WP03 critical failure surface ("readiness score SHOWN to user") — no route in this build unit
/// serializes this column directly; every rep-facing payload is built from `readiness_tier` only,
/// via readiness-engine.ts's public projector, which asserts the raw score is absent before return.
model ContactMethodProfile {
  id                         String         @id @default(uuid())
  user_id                    String
  contact_id                 String
  is_seed                    Boolean        @default(false) // in the Layer-1 Blank Canvas seed list
  needs_time                 Boolean        @default(false) // Layer 2 "need more time" -> slow-burn queue
  clusters                   QualityCluster[] @default([]) // assigned in Layer 2 (>=1 once reviewed; empty = not yet reviewed / needs_time)
  career_stage               String?        // Layer 3 tile: transitioning | early | established | near_retirement
  financial_situation        String?        // Layer 3 tile: building | stuck | just_starting | wealth_building
  family_context             String?        // Layer 3 tile (chip value)
  community_role             String?        // Layer 3 tile (chip value)
  note                       String?        // Layer 3 optional note (<=500 chars pre-encryption), ciphertext envelope at rest
  existing_licensee_flag     Boolean        @default(false) // §8.1 Layer 3 "flags immediate unsuitability e.g. an existing licensee" (soft exclusion, requires ack)
  existing_licensee_acked_at DateTime?      @db.Timestamptz(6)
  readiness_score            Int?           // 0-100, HIDDEN — see model header; never serialized raw (§8.2)
  readiness_tier             ReadinessTier? // the ONLY readiness datum ever exposed to a rep-facing payload
  queue_actioned_at          DateTime?      @db.Timestamptz(6)
  created_at                 DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime       @updatedAt @db.Timestamptz(6)

  @@unique([user_id, contact_id])
  @@index([user_id])
  @@index([user_id, readiness_tier])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Learning state, the two ratios & The Shift (§9.7-§9.8) [T-34]
// ═══════════════════════════════════════════════════════════════════════

// T-34 (§9.7 "the two ratios"; §9.5 item 5 "Ratio cards ... baseline defaults (20:5:1) labeled
// 'learning your community' until 20-50 real data points exist"; §9.9-7 "never NaN"): the durable
// per-rep learning-state row. Recomputed from real Contact.pipeline_stage / Appointment data by
// src/services/learning-state/learning-state.service.ts (never at module scope — constructed
// lazily per-request) and persisted here so the rep's current learning state survives across
// requests/instances, the same durability convention as `AgentKillSwitch` (T-31) above. Purely
// additive: no existing table/column/enum is altered or dropped.
//
// `status` mirrors src/services/learning-state/ratios.ts's `LearningStateStatus`: LEARNING (< 20
// data points — the fixed 20:5:1 baseline is shown, labeled "learning your community"), SHIFTING
// (20-49 — the rep's OWN real numbers are now shown, still labeled per the spec's literal 20-50
// range), SHIFTED (>= 50 — the rep's own established record, label removed). This durable
// LEARNING -> SHIFTING -> SHIFTED progression IS "the shift" the master spec's §9.8 heading names
// (via §9.7's "20:5:1" baseline-to-real-record transition) — the rep is handed their own real
// numbers, in place of a borrowed community-wide default, once they've earned enough real data.
// It is NOT a numeric-autonomy toggle on the agents themselves — that is the IPA_VALUE agent's own
// periodic, batched, Opus 4.8 self-optimization loop (§4.4/§9.9-10), already scaffolded by T-30 in
// agent-handlers.ts/runtime-model-map.ts and left untouched here; this table is the deterministic,
// real-data tally that FEEDS the ratio cards and any narrative IPA_VALUE eventually composes.
model LearningState {
  id                       String   @id @default(uuid())
  user_id                  String   @unique
  status                   String   @default("LEARNING") // LEARNING | SHIFTING | SHIFTED
  // Agent's Ratio (§9.7): introductions -> responses -> appointments set -> confirmed shows.
  agent_introductions      Int      @default(0)
  agent_responses          Int      @default(0)
  agent_appointments_set   Int      @default(0)
  agent_confirmed_shows    Int      @default(0)
  // Field Trainer's Ratio (§9.7): appointments run -> client signs / recruit joins. Belongs to the
  // human closer (the trainer who ran the appointment), scoped to this rep's own contacts.
  trainer_appointments_run Int      @default(0)
  trainer_closes           Int      @default(0)
  computed_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @updatedAt @db.Timestamptz(6)

  @@index([user_id])
}

// T-34 (§9.8 "The Shift" bounded daily ritual; uiux §5.3): one durable row per rep per calendar day
// (`session_date`, the rep-local YYYY-MM-DD), so an interrupted shift (uiux AC-5.3-7) resumes at
// the same stack position with cumulative elapsed time, and Today's done-state (AC-5.3-3) persists
// for the rest of that day. `skip_counts` is a JSON map of queue-item-id -> times skipped (uiux
// §5.3: once = moved to the end of the stack; twice = the item leaves the Shift for Today's queue).
model ShiftSession {
  id                  String    @id @default(uuid())
  user_id             String
  session_date        String // rep-local YYYY-MM-DD; one shift session per rep per day
  mode                String    @default("STANDARD") // STANDARD | SHORT (uiux §5.3 short mode, cap 3)
  phase               String    @default("OPEN") // OPEN | WORK | CLOSE | DONE
  stack_position       Int      @default(0)
  skip_counts          Json     @default("{}")
  accumulated_seconds  Int      @default(0) // frozen elapsed seconds from prior WORK spans (interrupted-resume)
  last_resumed_at      DateTime? @db.Timestamptz(6) // set when phase enters WORK; null while not actively running
  streak_count         Int      @default(0) // the rep's streak as of this session's close (§5.3, §12.5)
  grace_day_used       Boolean  @default(false)
  reflection_text      String?
  // §5.3 Close: "recap (approvals, confirmations, logs)".
  recap_approvals      Int      @default(0)
  recap_confirmations  Int      @default(0)
  recap_logs           Int      @default(0)
  completed_at         DateTime? @db.Timestamptz(6)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @updatedAt @db.Timestamptz(6)

  @@unique([user_id, session_date])
  @@index([user_id])
}
