  event_id   String
  event      TeamEvent @relation(fields: [event_id], references: [id])
  user_id    String
  state      String    // rsvp_yes | rsvp_no | attended | missed
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([event_id, user_id])
