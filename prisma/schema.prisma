// The Harvest — Prisma schema
// Evolved per master-spec §3 (Data model): /Users/erspaulding/Downloads/harvest-master-spec.md
//
// Design notes (apply throughout this file):
// - All ids are UUID v4 (`@default(uuid())`).
// - All timestamps are TIMESTAMPTZ (`@db.Timestamptz(6)` on every DateTime field).
// - PII-bearing string fields on Contact, WhySession, and profile records (User) are expected to
//   hold application-layer AES-256-GCM ciphertext (see src/services/compliance/encryption); Prisma
//   does not enforce encryption at the column level. Where a plaintext-derived lookup is required
//   (dedup, global opt-out), a separate deterministic *_hash column is stored instead of relying on
//   ciphertext equality (ciphertext varies by IV per encryption call).
// - Enum types are used for the twelve cross-cutting enumerations named in spec §3.1 (plus the
//   pre-existing CFEOutcome/OnboardingStep). Entity-specific status/type fields introduced by the
//   ~20 new §3.3 entities follow the baseline's existing convention (see ComplianceReviewQueue.status
//   below) of a `String` column with an inline comment enumerating the allowed values — this keeps
//   regulatory/config-shaped vocabularies (e.g. SecurityEvent.type) editable without a migration.
// - Most new entities reference `user_id` / `contact_id` / etc. as plain indexed scalar columns
//   rather than full Prisma `@relation`s, to avoid a combinatorial explosion of back-reference arrays
//   on User/Contact/Organization. Relations are declared explicitly only where existing application
//   code already depends on them (User↔Organization, User self-relation, Contact↔ContactInteraction,
//   User↔OnboardingSession) or where the relation is intrinsic to a new pair (MessageThread↔Message).
// - Doctrine vocabulary (§0.5, the forbidden-terms table) is kept clean in every identifier below
//   (only the spec-sanctioned agent name "Prospecting Agent" / its `prospecting` key, §4.2, appears).
//   No non-Claude AI provider name appears anywhere in this file (§0.3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════
// §3.1 Enumerations
// ═══════════════════════════════════════════════════════════════════════

/// Five-role architecture (spec §3.1 baseline-contradiction resolution: there are five roles,
/// not four; the baseline EXTERNAL value is retired — external solo users are `REP` with an
/// external-type Organization).
enum Role {
  REP
  UPLINE
  RVP
  ADMIN
  DUAL
}

enum OrgType {
  PRIMERICA
  EXTERNAL
}

/// Retires the baseline FREE/ESSENTIAL/PRO/ELITE enum to match the locked pricing (§0.2, §15).
enum AccessTier {
  FREE_ORG_LINKED
  FREE_PAID_EXTERNAL
  PAID_INDIVIDUAL
  ENTERPRISE
}

/// Canonical Low/Medium/High labels (§3.1); the baseline casual/standard/intensive labels are
/// retired. Also governs per-rep daily agent-action caps and Claude token budget (§4.2, §4.5).
enum IntensitySetting {
  LOW
  MEDIUM
  HIGH
}

/// User.onboarding_status — distinct from the step-resumption state machine kept on
/// OnboardingSession.current_step (below): nothing downstream of onboarding is reachable until
/// GATED_COMPLETE (§1.4).
enum OnboardingStatus {
  IN_PROGRESS
  GATED_COMPLETE
}

/// Retained from baseline for OnboardingSession.current_step (linear resumption state); §3.2
/// notes this is superseded in part by WhySession for the Seven Whys transcript itself.
enum OnboardingStep {
  REGISTER
  ACCOUNT_TYPE
  SEVEN_WHYS
  GOAL_CARD
  INTENSITY
  COMPLETE
}

/// Contact.pipeline_stage. Replaces the baseline's free-text DISCOVERY/QUALIFY/NURTURE/
/// APPOINTMENT/CLIENT progression with the ten-stage vocabulary in spec §3.1.
enum PipelineStage {
  IDENTIFIED
  INTRODUCED
  RESPONDED
  APPOINTMENT_PROPOSED
  APPOINTMENT_CONFIRMED
  MET
  CLOSED_CLIENT
  CLOSED_RECRUIT
  DORMANT
  DO_NOT_CONTACT
}

/// T-22 (§7.1, §18.5): lifecycle of a Vault contact-import batch. Deliberately two states only —
/// `IN_PROGRESS` covers both "still running" and "crashed/partially failed but resumable" (there is
/// no separate FAILED state: a hard stop mid-batch is not a terminal failure, it is exactly the
/// resumable checkpoint `cursor` describes) — and `COMPLETED`, which also doubles as the
/// idempotency short-circuit: a retry against a `COMPLETED` batch (same user + idempotency_key)
/// replays the stored result instead of reprocessing any row.
enum ImportBatchStatus {
  IN_PROGRESS
  COMPLETED
}

enum CFEOutcome {
  PASS
  FLAG
  BLOCK
  /// T-10 (audit store, §5.6/§5.7/§17.8): a non-CFE audit event funneled into the unified store
  /// from licensing (T-13), data-rights (T-11), or account-security (T-12) — informational
  /// evidence, not a CFE risk-band adjudication, so it is never conflated with PASS/FLAG/BLOCK.
  RECORDED
}

/// Shared across DraftMessage, MessageThread, Message, and OptOutRegistry so a single opt-out
/// check (§3.4) can be expressed against exactly the channels agents send on.
enum MessageChannel {
  SMS_HANDOFF
  SMS_PLATFORM
  EMAIL
  SOCIAL_DM
  IN_APP
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageSource {
  AGENT
  REP
  UPLINE
  SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  DISPUTED
}

/// Drives the Downline-Sponsor free-tier provisioning and lapse cascade (§15).
enum SponsorshipState {
  ACTIVE
  MEMBER_GRACE
  SPONSOR_LAPSED
  ANNIVERSARY_PENDING
  CONVERTED
  ENDED
}

// ═══════════════════════════════════════════════════════════════════════
// §3.2 Entities kept from the baseline (extended)
// ═══════════════════════════════════════════════════════════════════════

model Organization {
  id                     String   @id @default(uuid())
  name                   String
  type                   OrgType
  white_label_theme      Json?    // enterprise Phase-2 hook
  compliance_contact_id  String?  // escalation target for flagged content (§5.3, §5.5 48h escalation)
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  users                  User[]
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  password_hash         String
  name                  String
  phone                 String?
  role                  Role              @default(REP)
  org_type              OrgType           @default(EXTERNAL)
  solution_number        String?          // nullable, encrypted, Primerica only
  upline_id             String?
  upline                User?             @relation("UserUpline", fields: [upline_id], references: [id])
  downlines             User[]            @relation("UserUpline")
  access_tier           AccessTier        @default(FREE_ORG_LINKED)
  intensity_setting     IntensitySetting  @default(MEDIUM)
  commitment_score      Int               @default(0)
  rank                  String?
  anchor_statement      String?           // encrypted; from WP01 Flow C (Seven Whys anchor)
  finra_u4_status       String?           // VALIDATED | PENDING | SUSPENDED | NOT_APPLICABLE
  calendar_preferences  Json?
  calendar_connected    Boolean           @default(false)
  gdpr_consent          Boolean           @default(false)
  onboarding_status     OnboardingStatus  @default(IN_PROGRESS)
  mfa_enrolled          Boolean           @default(false)
  mfa_methods           Json?
  // T-12 (§16.4 session security): bumped on "sign out everywhere" and on a privilege/role
  // rotation event. Snapshotted into the JWT at sign-in (`securityVersionAtIssue`); a session
  // whose snapshot no longer matches the live value here is treated as revoked (src/lib/auth/
  // session-security.ts `evaluateSessionSecurity`), which is how a stateless JWT session supports
  // server-side revocation without a live session-token table.
  security_version      Int               @default(0)
  // T-12 CRITICAL fix (§16.4 step-up MFA): a short-lived, SINGLE-USE server proof that a real
  // TOTP/recovery challenge just succeeded. POST /api/auth/mfa/step-up stamps this (server clock)
  // ONLY after `verifyMfaCode` passes; the jwt `update` callback (src/lib/auth/options.ts) is the
  // sole reader — it consumes (clears) this and stamps the session's `mfaVerifiedAt` from it, so a
  // client `useSession().update()` payload can no longer self-certify step-up freshness (the
  // freshness signal now originates only from a server-verified challenge). Null when no
  // unconsumed proof is outstanding, which is the normal resting state.
  mfa_stepped_up_at     DateTime?         @db.Timestamptz(6)
  organization_id       String?
  organization          Organization?     @relation(fields: [organization_id], references: [id])
  onboarding_sessions   OnboardingSession[]
  // Auth.js / NextAuth Prisma-adapter contract fields (T-04, §16.4). Nullable and unused by the
  // Credentials-provider + JWT-session flow this unit wires up; present so the adapter can be
  // handed to an OAuth provider (§6.3 Flow A: "auth: email/password or OAuth") in a later unit
  // without a further schema migration. emailVerified/image follow the adapter's exact expected
  // field names (camelCase), an intentional exception to this file's snake_case convention (§3
  // header note) because they are part of the Auth.js adapter contract, not app-owned columns.
  emailVerified         DateTime?         @db.Timestamptz(6)
  image                 String?
  accounts              Account[]
  sessions              Session[]
  created_at            DateTime          @default(now()) @db.Timestamptz(6)
  updated_at            DateTime          @updatedAt @db.Timestamptz(6)

  @@index([upline_id])
  @@index([organization_id])
}

// ═══════════════════════════════════════════════════════════════════════
// Auth.js (NextAuth v4) Prisma-adapter contract models (T-04, §16.4/§16.6 scaffold)
// ═══════════════════════════════════════════════════════════════════════
//
// These three models are the canonical Auth.js Prisma schema (https://authjs.dev/reference/adapter/prisma)
// required to type `PrismaAdapter(prisma)` (src/lib/auth/options.ts). Field names are camelCase
// per the adapter's fixed contract — do not rename to snake_case, the adapter maps to these exact
// names. The active auth flow in this unit is Credentials + JWT sessions, which does not exercise
// Account/Session rows at runtime (see src/lib/auth/options.ts comments); they exist so (a) the
// adapter type-checks against this schema today and (b) an OAuth provider can be added later with
// zero further migration. VerificationToken supports a future email/magic-link provider.

model Account {
  id                 String   @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
}

// The Vault record. PII fields (first_name/last_name/phone/email/notes) are expected to hold
// application-layer AES-256-GCM ciphertext; phone_hash/email_hash are deterministic *keyed*
// HMAC-SHA256 hashes (see src/services/compliance/encryption/encryption.ts `hmacForMatch`, keyed
// by the server-side `CONTACT_HASH_PEPPER` secret — never an unkeyed/plain SHA-256, which would be
// reversible for low-entropy inputs like phone numbers) used for opt-out matching and cross-rep
// dedup without exposing plaintext (§3, intro). Interaction history is per-rep and never
// cross-rep visible (§3.4).
model Contact {
  id                  String           @id @default(uuid())
  user_id             String
  first_name          String
  last_name           String           @default("")
  phone               String?
  email               String?
  phone_hash          String?
  email_hash          String?
  notes               String?
  relationship_type   String?
  industry            String?          // additive: feeds the Hidden Earnings industry multiplier (§8)
  segment_score       Int              @default(0) // 0–100
  is_recruit_target   Boolean          @default(false)
  is_client           Boolean          @default(false)
  is_a_list           Boolean          @default(false)
  pipeline_stage      PipelineStage    @default(IDENTIFIED)
  last_contact_date   DateTime?        @db.Timestamptz(6)
  source              String           @default("MANUAL")
  import_batch_id     String?
  do_not_contact      Boolean          @default(false)
  agents_paused       Boolean          @default(false)
  household_id        String?          // nullable; household intelligence (blueprint #17)
  is_minor_flag       Boolean          @default(false)
  // T-29R (WP03 §8.2 "Excluded: state-unlicensed" tier / §8.1 eligibility): the contact's own
  // jurisdiction — a two-letter US state postal code, e.g. "TX" — normalized/compared the same way
  // as LicensingRecord.jurisdiction (src/types/licensing.ts). Consumed ONLY by
  // src/services/harvest-method/eligibility.ts's `checkJurisdictionExclusion`, which excludes a
  // contact for a REGULATED (Primerica) rep when the rep is not LICENSED in this state (or when the
  // rep's licensed jurisdictions are unavailable — fail-closed); a no-op for a universal rep (§17.1).
  //
  // Deliberately PLAINTEXT, not AES-256-GCM ciphertext like first_name/last_name/phone/email/notes
  // above: (1) T-22's own doc comment (this model's header, and vault-encryption.ts) names the
  // encrypted PII surface explicitly as first_name/last_name/phone/email/notes — a coarse ~50-value
  // categorical field (which US state) is not on that list, the same way industry/relationship_type/
  // pipeline_stage/career_stage/financial_situation are plaintext categorical fields on Contact/
  // ContactMethodProfile today; (2) this codebase's own established classification of "jurisdiction"
  // as non-identifying STRUCTURAL/status data rather than an identifying credential already exists
  // for the analogous LicensingRecord.jurisdiction column (see the QC-2 carve-out rationale in
  // src/services/compliance/data-rights/data-rights.ts's `processDeletion`: license_number is
  // scrubbed on a GDPR/CCPA deletion, jurisdiction/state is deliberately left untouched as
  // non-identifying status data); (3) the T-R7/R8/R9 ripple (DSAR export / dedup) documented the real
  // cost of encrypting a Contact column that downstream consumers need to read/match on — encrypting
  // a field that carries none of the same re-identification risk as a name/phone/email would
  // reintroduce that exact regression for no compliance benefit.
  jurisdiction        String?
  linked_user_id      String?          // set when a contact becomes a platform user
  memory_jogger_skip_count Int         @default(0) // T-23 (§7.4): a jogger that surfaces an already-Vaulted contact increments this and skips, instead of re-adding a duplicate
  // T-38 (master-spec §10.4 recipient-timezone quiet hours): the contact's own IANA timezone id
  // (e.g. "America/Chicago"), used by SendComplianceGate/isWithinQuietHours to compute the
  // recipient's LOCAL 8 AM–9 PM send window — deliberately distinct from any rep-side notification
  // timezone/quiet-hours setting (§10.4 "distinct from the rep's own notification quiet hours").
  // Nullable — deliberately: an unknown timezone is NOT defaulted to UTC or the rep's own zone, it
  // fails CLOSED (treated as within quiet hours, i.e. blocked) in isWithinQuietHours. Deliberately
  // PLAINTEXT like industry/relationship_type/jurisdiction above — an IANA zone id is coarse
  // categorical/structural data, not an identifying credential, so it is not in this model's
  // encrypted-PII surface (first_name/last_name/phone/email/notes).
  timezone            String?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @updatedAt @db.Timestamptz(6)
  interactions        ContactInteraction[]

  @@index([user_id])
  @@index([user_id, pipeline_stage])
  @@index([phone_hash])
  @@index([email_hash])
  @@index([household_id])
}

// Extended to reference Message and AgentRun (both plain scalar pointers, §3 new-entities table)
// for the unified per-contact conversation timeline.
model ContactInteraction {
  id             String   @id @default(uuid())
  contact_id     String
  type           String   @default("NOTE")
  notes          String   @default("")
  message_id     String?
  agent_run_id   String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  contact        Contact  @relation(fields: [contact_id], references: [id])

  @@index([contact_id])
  @@index([message_id])
  @@index([agent_run_id])
}

// Retained for step-resumption state; the richer Seven Whys transcript + anchor lives on
// WhySession (below), per §3.2.
model OnboardingSession {
  id             String         @id @default(uuid())
  user_id        String
  user           User           @relation(fields: [user_id], references: [id])
  current_step   OnboardingStep @default(REGISTER)
  seven_whys     Json?
  goal_card      Json?
  intensity_data Json?
  completed      Boolean        @default(false)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
}

// Append-only CFE decision log — the compliance evidence trail and the source of the rep-visible
// Agent Activity Ledger (§5.6). Access-restricted and segregated so a GDPR deletion can remove
// ordinary user data while lawfully retaining FINRA-required communications (§16.3).
//
// T-10 (audit store, §5.6/§16.1 "immutability (append-only, signed audit)"): `sequence`/
// `prev_hash`/`entry_hash` are additive hash-chain tamper-evidence columns — no existing column
// was changed or dropped. `sequence` is a monotonic autoincrement independent of `created_at`
// (TIMESTAMPTZ can collide under concurrent writers; a dedicated sequence cannot), giving the hash
// chain a stable, gapless append order to verify. `entry_hash` is SHA-256 over the row's own
// content + `prev_hash` (`src/services/compliance/audit/hash-chain.ts`); `prev_hash` is `null`
// only for the very first row ever appended. There is deliberately no update/delete path anywhere
// in the application layer for this model (`src/services/compliance/audit/audit-service.ts`'s
// `AuditRepository` interface declares only `append`/`query`/`getById`/`getChainTail`) — mutability
// here is the WP11 QC checklist's named critical-failure condition ("a mutable or unsigned audit
// trail").
model AuditEntry {
  id              String     @id @default(uuid())
  sequence        Int        @unique @default(autoincrement())
  user_id         String
  content_id      String?
  content_text    String
  content_hash    String
  channel         MessageChannel?
  risk_score      Int
  outcome         CFEOutcome
  classifier_data Json
  rule_version    String
  regulation      String
  reviewer_id     String?
  reviewer_action String?
  role            Role       @default(REP)
  prev_hash       String?
  entry_hash      String     @default("")
  created_at      DateTime   @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([user_id, created_at])
  @@index([content_id])
}

// T-R4 (WP11 audit hardening — external anchoring / tail-truncation detection, master-spec §16.1
// "immutability (append-only, signed audit)"): a hash chain alone cannot detect truncation of the
// TAIL of the chain — deleting the most-recently-appended row(s) with nothing appended after them
// leaves no broken `prev_hash` link for `verifyChain` to catch (see the "honest limitation"
// documented in `src/services/compliance/audit/hash-chain.ts`). This table is the externally
// anchored checkpoint that closes that gap: a periodic job (`AuditService.createCheckpoint` /
// `src/services/compliance/audit/anchoring.ts`) snapshots the current chain head
// (`AuditEntry.sequence`/`entry_hash`, from `getChainTail()`) plus the total row count, and signs
// (SHA-256-hashes) that snapshot into `checkpoint_hash`. A later `AuditService.verifyAnchoring()`
// re-reads the chain and confirms the row at the checkpointed `sequence` still exists with the
// same `head_entry_hash` and that the current row count hasn't shrunk below `entry_count` — either
// mismatch proves the tail was truncated (or the checkpoint record itself was corrupted, caught by
// recomputing `checkpoint_hash`) since that checkpoint was taken. Append-only and immutable at the
// DB level the same way `AuditEntry` is (see the `prevent_audit_mutation()` trigger in this
// migration) — a checkpoint is itself compliance evidence and must not be alterable either.
model AuditCheckpoint {
  id              String   @id @default(uuid())
  // The anchored chain head's AuditEntry.sequence at checkpoint time (getChainTail().sequence).
  sequence        Int
  // The anchored chain head's AuditEntry.entry_hash at checkpoint time (getChainTail().entry_hash).
  head_entry_hash String
  // Total row count in the store at checkpoint time — independent corroboration of `sequence`
  // (both should agree when the chain is gapless; a mismatch is itself a signal worth surfacing).
  entry_count     Int
  // SHA-256 over { sequence, head_entry_hash, entry_count, created_at } (stable-serialized) — the
  // checkpoint's own tamper-evidence, so a corrupted/edited checkpoint row is self-detectable too.
  checkpoint_hash String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([sequence])
}

// T-38 additions (master-spec §10.4 TCPA consent ledger; §16.2 "TCPA | ... | Per-contact consent"):
// `contact_id` + `version` are purely additive (both nullable/defaulted, no backfill required).
// This model originally tracked only platform-USER-level consent (profile/contacts/calendar/
// agent_logs/analytics/gdpr — §16.3's signup consent capture, see src/lib/onboarding/
// gdpr-consent.ts). The TCPA messaging-consent ledger (src/services/compliance/messaging-consent/)
// reuses this SAME table rather than forking a parallel one — a row with `contact_id` set (and
// `consent_type` = the ledger's `MESSAGING_TCPA_CONSENT_TYPE` constant) is a per-RECIPIENT-contact
// consent record; a row with `contact_id` null is the original per-platform-user record. `user_id`
// is always the owning rep either way (for a contact-scoped row, the rep whose Vault the contact
// belongs to), so existing per-user queries (`user_id, timestamp`) keep working unmodified.
model ComplianceConsent {
  id              String   @id @default(uuid())
  user_id         String
  contact_id      String?  // NEW (T-38): set only for per-contact (recipient) consent rows.
  consent_type    String
  given           Boolean
  // NEW (T-38): durable version number for this (subject, consent_type) lineage. Pre-T-38 rows
  // (the GDPR bridge, src/lib/onboarding/gdpr-consent.ts) never wrote this column and relied on
  // WP11's in-process `ConsentManager` Map for versioning instead — that version number never
  // reached the DB row, so it did not survive a process restart / multi-instance deploy. Every
  // NEW write from the T-38 messaging-consent ledger computes and persists the real next version
  // here so "versioned" is durable, not process-local. Existing rows default to 1 — harmless,
  // since nothing read this column before this unit.
  version         Int      @default(1)
  timestamp       DateTime @default(now()) @db.Timestamptz(6)

  @@index([timestamp])
  @@index([user_id, timestamp])
  @@index([contact_id, consent_type]) // NEW (T-38): the messaging-consent ledger's lookup path.
  // NEW (T-R17, remediation of a T-38 QC finding, §9.2): under a concurrent same-contact
  // messaging-consent write, two `captureConsent` calls could both read the same "current"
  // version and both insert with the SAME next version number — two rows silently sharing one
  // version, with whichever sort order the DB happened to return deciding which one "wins" as
  // current. This constraint makes that race DETECTABLE (the loser's INSERT throws a Prisma
  // P2002, which `MessagingConsentLedger.captureConsent` catches and retries against the
  // now-current version — see messaging-consent-ledger.ts) instead of silently landing two rows on
  // one version number.
  //
  // Deliberately a PLAIN `@@unique`, not a hand-authored partial index (contrast `Subscription`'s
  // `WHERE status = 'ACTIVE'` partial index above): Postgres treats NULL as DISTINCT from every
  // other NULL in a unique index by default (this has always been Postgres's default — the
  // opt-in `NULLS NOT DISTINCT` clause, PG 15+, is not used anywhere in this schema), so a plain
  // `UNIQUE("contact_id", "consent_type", "version")` NEVER constrains the `contact_id = NULL`
  // rows against each other. That is exactly the WP11 onboarding-consent shape
  // (`src/lib/onboarding/gdpr-consent.ts` writes `contact_id` unset -> NULL, and never sets
  // `version` -> always the schema default, 1) — many `contact_id = NULL, consent_type = 'gdpr',
  // version = 1` rows already coexist there (one per grant/revoke event; WP11's real versioning
  // lives in `ConsentManager`'s in-process Map, not this column) and must go on doing so
  // unconstrained. The race this unit fixes is specifically PER-CONTACT (`contact_id` set, T-38's
  // messaging ledger), so a plain unique — which only ever fires when `contact_id` is a real,
  // matching, non-null value — is the correct, narrower tool; a partial index would be strictly
  // more machinery for the same result here. See tests/unit/gdpr-consent.test.ts and
  // tests/unit/messaging-consent-ledger.test.ts for the regression/race proofs.
  @@unique([contact_id, consent_type, version])
}

// Parameterized regulatory rules — a regulatory change is a config update, not a code change (§5.3).
model ComplianceRule {
  id              String   @id @default(uuid())
  name            String
  regulation      String
  version         String
  parameters      Json
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
}

model ComplianceReviewQueue {
  id              String   @id @default(uuid())
  audit_entry_id  String   @unique
  status          String   // PENDING, APPROVED, REJECTED, MODIFIED
  upline_id       String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
}

model ComplianceUplineReview {
  id              String   @id @default(uuid())
  audit_entry_id  String
  reviewer_id     String
  action          String
  feedback        String?
  timestamp       DateTime @default(now()) @db.Timestamptz(6)
}

model ComplianceException {
  id              String   @id @default(uuid())
  audit_entry_id  String
  reason          String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
}

model UserDataExport {
  id              String   @id @default(uuid())
  user_id         String
  status          String   // PENDING, COMPLETED, FAILED
  expires_at      DateTime @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
}

// retained_fields + deletion_certificate_url are new (§3.2): the FINRA 2210/3110 legal-hold
// carve-out. A deletion removes rep-owned PII and cascades opt-outs by hash across other reps'
// copies, while retained_fields preserves what the segregated FINRA archive lawfully keeps; the
// certificate documents exactly what was retained and why (§3.4, §16.3).
model UserDataDeletion {
  id                       String    @id @default(uuid())
  user_id                  String
  status                   String    // PENDING, COMPLETED, HELD, FAILED — HELD = blocked by an active LegalHold (§16.3)
  anonymized_fields        String[]
  retained_fields          String[]  @default([])
  deletion_certificate_url String?
  requested_at             DateTime  @default(now()) @db.Timestamptz(6)
  completed_at             DateTime? @db.Timestamptz(6)

  @@index([user_id, status])
}

// T-11 (data rights, §16.3): a legal hold on a user blocks deletion processing outright — a
// UserDataDeletion request against a user with an ACTIVE LegalHold is recorded with
// status = "HELD" and no PII is touched until the hold is lifted. Additive/localized to the
// data-rights area; does not alter any model owned by the concurrent CFE build (AuditEntry,
// ComplianceException, etc.).
model LegalHold {
  id          String    @id @default(uuid())
  user_id     String
  status      String    @default("ACTIVE") // ACTIVE | LIFTED
  reason      String    // e.g. "FINRA regulatory inquiry", "active litigation"
  placed_by   String    // user_id of the admin/RVP who placed the hold
  placed_at   DateTime  @default(now()) @db.Timestamptz(6)
  lifted_by   String?
  lifted_at   DateTime? @db.Timestamptz(6)
  note        String?

  @@index([user_id, status])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Agent layer (§4)
// ═══════════════════════════════════════════════════════════════════════

model AgentDefinition {
  id                  String   @id @default(uuid())
  key                 String   @unique // e.g. "prospecting"
  display_name        String
  default_model       String   // haiku_4_5 | sonnet_5 | opus_4_8 (Claude-only, §0.3/§4.4)
  mode                String   // parallel | sequential
  enabled             Boolean  @default(true)
  prompt_template_ref  String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)
}

// One execution of an agent job; feeds the Activity Ledger and the per-rep cost model (§4.5).
model AgentRun {
  id             String    @id @default(uuid())
  agent_key      String
  user_id        String
  trigger        String
  model_used     String    // haiku_4_5 | sonnet_5 | opus_4_8
  input_summary  String?
  output_ref     String?
  token_input    Int       @default(0)
  token_output   Int       @default(0)
  cost_cents     Int       @default(0)
  batched        Boolean   @default(false)
  status         String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | HELD
  reasoning_log  String?   // plain-language, rep-visible (§4.1 #5)
  started_at     DateTime? @db.Timestamptz(6)
  finished_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at])
  @@index([agent_key])
}

// T-31 (§4.5/§4.6) — the kill-switch state: PLATFORM (singleton, scope_id = 'GLOBAL'), ORG
// (scope_id = Organization.id), or REP (scope_id = User.id). A missing row means "not tripped"
// (the default posture). Budget ceilings themselves are NOT persisted here — they are computed
// from User.access_tier x User.intensity_setting (per-rep) or a documented org/platform aggregate
// constant (§4.5), with the live spend read straight off the AgentRun.cost_cents roll-up per the
// spec's "every AgentRun ... gives a live per-rep and per-org cost roll-up" design. This table only
// persists the TRIPPED/CLEARED state so a kill-switch (manual or budget-auto-tripped) survives
// across requests/instances and is toggleable via a session-gated, ownership-checked route.
model AgentKillSwitch {
  id          String    @id @default(uuid())
  scope       String    // PLATFORM | ORG | REP
  scope_id    String    // 'GLOBAL' for PLATFORM; Organization.id for ORG; User.id for REP
  tripped     Boolean   @default(false)
  reason      String?
  tripped_by  String?   // user_id of the admin/rep who tripped it; null when auto-tripped (budget breach)
  tripped_at  DateTime? @db.Timestamptz(6)
  cleared_by  String?
  cleared_at  DateTime? @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([scope, scope_id])
  @@index([scope, scope_id, tripped])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Messaging (§5, §10)
// ═══════════════════════════════════════════════════════════════════════

// An agent- or rep-drafted outbound item awaiting CFE + approval (§5.5, §18.1: any edit after
// approval must re-enter the CFE before send — enforced at the application layer via
// edited_after_approval).
model DraftMessage {
  id                    String          @id @default(uuid())
  user_id               String
  contact_id            String
  channel               MessageChannel
  body                  String
  cfe_outcome           CFEOutcome?
  cfe_risk_score        Int?
  cfe_classifier_data   Json?
  approval_state        String          @default("PENDING") // PENDING | APPROVED | DECLINED | HELD
  approved_by           String?
  approved_at           DateTime?       @db.Timestamptz(6)
  edited_after_approval Boolean         @default(false)
  // T-33 (§9.2/uiux §5.6): the Approval Inbox decline-reason selector ("not my voice / wrong
  // person / wrong time / other" + optional note) — feeds agent learning per the uiux spec.
  // Additive, nullable; both are only ever set on a decline.
  decline_reason        String?
  decline_note          String?
  // T-37 (WP05 §10.1/§10.8; uiux §4.4 "held" states) — records WHY the unified send decision
  // (src/services/messaging/send/*) withheld a send for this draft at dispatch time, distinct from
  // a human `decline_reason`: OPTED_OUT | QUIET_HOURS | NO_TCPA_CONSENT | NOT_DELIVERABLE |
  // NOT_CFE_CLEARED | NOT_APPROVED | EDITED_AFTER_APPROVAL | CHANNEL_MISMATCH | TWILIO_UNCONFIGURED
  // | NO_PLATFORM_NUMBER | NO_PHONE | ERROR. Additive, nullable; set on a held send, cleared to
  // null on a successful send/handoff. This is the "held for review — nothing was lost" (§5.2)
  // evidence the rep-facing timeline surfaces; it never causes a send by itself (deny-by-default).
  send_hold_reason      String?
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@index([contact_id])
}

model MessageThread {
  id               String          @id @default(uuid())
  user_id          String
  contact_id       String
  channel          MessageChannel
  state            String          @default("ACTIVE") // ACTIVE | REACTIVATED | CLOSED
  last_activity_at DateTime        @default(now()) @db.Timestamptz(6)
  messages         Message[]

  @@index([user_id, contact_id])
}

model Message {
  id                 String            @id @default(uuid())
  thread_id          String
  thread             MessageThread     @relation(fields: [thread_id], references: [id])
  direction          MessageDirection
  source             MessageSource
  channel            MessageChannel
  body               String            // encrypted at rest
  cfe_audit_id       String?           // link to AuditEntry.id
  // T-39 (T-R16 fold-in; uiux §4.7 agent-sent badge "sent by your agent · approved by you [date]").
  // The APPROVAL ATTRIBUTION denormalized onto the immutable sent record so the conversation
  // timeline can render the transparency/compliance badge without re-joining the (mutable, possibly-
  // pruned) DraftMessage. Both are carried from the DraftMessage's approved_by/approved_at at the
  // moment of send (an agent-sourced OUTBOUND message with these set is what earns the badge).
  // Additive, nullable: an inbound message, a system event, or a pre-T-39 row simply has them null.
  approved_by        String?
  approved_at        DateTime?         @db.Timestamptz(6)
  sent_from          String?           // rep_number | platform_number | email_domain
  delivery_status    String            @default("PENDING")
  handoff_confirmed  Boolean           @default(false) // composer handoff confirmation (§10)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)

  @@index([thread_id, created_at])
  @@index([cfe_audit_id])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — WP05 outreach sequences + three-way handoff (§10.2/§10.6) [T-39]
//
// All ADDITIVE. State/type fields are plain `String` with an inline enumeration comment —
// matching the existing messaging models' convention (DraftMessage.approval_state,
// MessageThread.state, Message.delivery_status, OptOutRegistry.reason are all String), so this
// migration adds no new enum. No FK crosses a rep/org boundary; visibility gating is enforced in
// the service layer (upline sees a handoff only when it carries their upline_id AND organization_id).
// ═══════════════════════════════════════════════════════════════════════

// The doctrine-safe multi-touch cadence (§10.2): warm open → social proof → reflected qualities →
// soft ask → low-pressure next step. Never a "NLP close". One row per contact per enrolled cadence.
model OutreachSequence {
  id                 String   @id @default(uuid())
  user_id            String
  contact_id         String
  // FAST_TRACK (5d) | STANDARD (14d) | NURTURE (30d) | RE_ENGAGEMENT (custom) — §10.2 sequence types.
  sequence_type      String
  // ACTIVE | PAUSED | STOPPED | COMPLETED. PAUSES on reply/opt-out/compliance-block (§10.8) — a
  // paused/stopped sequence never fires another step.
  state              String   @default("ACTIVE")
  // Why the sequence is not ACTIVE: REPLY | OPT_OUT | COMPLIANCE_BLOCK | MANUAL (null while ACTIVE).
  pause_reason       String?
  current_step_index Int      @default(0)
  started_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)
  steps              OutreachSequenceStep[]

  @@index([user_id])
  @@index([contact_id])
  @@index([user_id, state])
}

// One scheduled touch in a sequence. `draft_id` is the DraftMessage this step dispatches THROUGH the
// T-37 send seam (which enforces CFE-cleared + approved + SendComplianceGate + deliverability) — the
// step itself never sends; it hands `draft_id` to the seam and reacts to the { status } result.
model OutreachSequenceStep {
  id               String           @id @default(uuid())
  sequence_id      String
  sequence         OutreachSequence @relation(fields: [sequence_id], references: [id], onDelete: Cascade)
  step_index       Int
  channel          MessageChannel
  scheduled_at     DateTime         @db.Timestamptz(6)
  // SCHEDULED | SENT | HELD | SKIPPED | DEFERRED | CANCELED.
  status           String           @default("SCHEDULED")
  draft_id         String?
  // Mirrors DraftMessage.send_hold_reason for the step when the seam HELD its dispatch (evidence).
  send_hold_reason String?
  sent_message_id  String?
  dispatched_at    DateTime?        @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)

  @@index([sequence_id, step_index])
  @@index([status, scheduled_at])
}

// The edification / warm-intro-to-upline three-way handoff (§10.5/§10.6; uiux §5.7): a buying signal
// or a hard question bridges the rep's upline into the same thread. Upline visibility is org-gated —
// `organization_id` + `upline_id` are the ONLY keys a visibility query filters on, so a handoff can
// never surface to a different org's upline, a cross-line rep, or a rep who is not this rep's upline.
model ThreeWayHandoff {
  id                 String    @id @default(uuid())
  user_id            String    // the rep who owns the contact/thread
  upline_id          String    // the rep's upline at trigger time (the human invited to bridge)
  organization_id    String    // org gate — visibility never crosses organizations
  contact_id         String
  thread_id          String?
  // BUYING_SIGNAL | HARD_QUESTION | MANUAL — §10.6 triggers.
  trigger_reason     String
  // INVITED | JOINED | RETURNED | CLOSED. RETURNED = the 24h no-join return-to-rep path (§10.9-8).
  state              String    @default("INVITED")
  invited_at         DateTime  @default(now()) @db.Timestamptz(6)
  joined_at          DateTime? @db.Timestamptz(6)
  returned_at        DateTime? @db.Timestamptz(6)
  // invited_at + 24h; a still-INVITED handoff past this returns to the rep with a coached next step.
  return_deadline_at DateTime  @db.Timestamptz(6)
  coached_next_step  String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@index([upline_id, organization_id])
  @@index([contact_id])
  @@index([state, return_deadline_at])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Calendar & appointments (§14)
// ═══════════════════════════════════════════════════════════════════════

// slot_lock_id carries a unique constraint: this is the schema-level expression of "two agents
// cannot book the same trainer slot" (§3.4, §18.4) — an atomic confirm is a unique-key insert/
// update, not an application-level race.
model Appointment {
  id                 String    @id @default(uuid())
  rep_id             String
  trainer_id         String?
  contact_id         String
  proposed_windows   Json?
  confirmed_start    DateTime? @db.Timestamptz(6)
  confirmed_end      DateTime? @db.Timestamptz(6)
  governing_timezone String?   // the contact's timezone governs, per spec
  status             String    @default("PROPOSED") // PROPOSED|CONFIRMED|RESCHEDULED|DECLINED|HELD|NO_SHOW
  slot_lock_id       String?   @unique
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)

  @@index([rep_id])
  @@index([contact_id])
  @@index([trainer_id])
}

model CalendarLink {
  id         String   @id @default(uuid())
  user_id    String
  provider   String   // google | caldav_ios
  status     String   @default("CONNECTED") // CONNECTED | EXPIRED | REVOKED
  scope      String?
  token_ref  String?  // pointer to the secret store — never a token value (§0.4)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([user_id])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Billing & sponsorship (§15)
// ═══════════════════════════════════════════════════════════════════════

// INVARIANT (§15, double-provisioning guard): a user may have at most one row with
// status = ACTIVE. Prisma's `@@unique` cannot express a conditional/partial constraint, so this
// is enforced in Postgres via a partial unique index added by hand to the migration SQL
// (prisma/migrations/<ts>_evolve_to_spec_v3/migration.sql):
//   CREATE UNIQUE INDEX "subscription_one_active_per_user" ON "Subscription"("user_id")
//     WHERE "status" = 'ACTIVE';
// This is *not* expressible in this file — do not remove the hand-appended SQL when regenerating
// migrations from this schema.
model Subscription {
  id                     String              @id @default(uuid())
  user_id                String
  stripe_subscription_id String?             @unique
  // T-47R (WP10 gate remediation, master-spec §15.7-8 chargeback AC): the Stripe CUSTOMER id,
  // additive/nullable. `charge.dispute.created` only exposes charge/customer (never the
  // subscription id or our user id) — without a customer→subscription map, a dispute event can
  // never be resolved back to a user, which is exactly why the chargeback path was dead scaffold
  // before this migration. Persisted by `onCheckoutCompleted` (the checkout session always carries
  // the Stripe customer id); read by `onDisputeCreated` to resolve the disputing customer to a
  // live subscription/user. Indexed for that lookup.
  stripe_customer_id     String?
  plan_tier              String              // free | individual | enterprise
  billing_cycle          String              // monthly | annual
  status                 SubscriptionStatus
  current_period_start   DateTime?           @db.Timestamptz(6)
  current_period_end     DateTime?           @db.Timestamptz(6)
  org_sponsored          Boolean             @default(false)
  sponsor_user_id        String?
  created_at             DateTime            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime            @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@index([stripe_customer_id])
}

// The Downline-Sponsor → member relationship. Drives free-tier provisioning and the lapse
// cascade (§15).
//
// INVARIANT (§15, double-provisioning guard): a member (`member_user_id`) may have at most one
// row with state = ACTIVE — the same partial-unique-index technique as Subscription above, hand-
// appended to the migration SQL since Prisma `@@unique` cannot be conditional:
//   CREATE UNIQUE INDEX "sponsorship_one_active_per_member" ON "Sponsorship"("member_user_id")
//     WHERE "state" = 'ACTIVE';
model Sponsorship {
  id                String           @id @default(uuid())
  sponsor_user_id   String
  member_user_id    String
  organization_id   String
  state             SponsorshipState
  term_start        DateTime?        @db.Timestamptz(6)
  term_end          DateTime?        @db.Timestamptz(6)
  grace_until       DateTime?        @db.Timestamptz(6)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @updatedAt @db.Timestamptz(6)

  @@index([sponsor_user_id])
  @@index([member_user_id])
}

model Invoice {
  id                String    @id @default(uuid())
  user_id           String
  subscription_id   String?
  stripe_invoice_id String?   @unique
  amount_cents      Int
  currency          String    @default("usd")
  status            String    @default("OPEN") // OPEN | PAID | VOID | UNCOLLECTIBLE
  issued_at         DateTime? @db.Timestamptz(6)
  paid_at           DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id])
}

// Stored Stripe payment-method ids only — no PANs ever touch this table (§0.4, §2.5).
model PaymentMethod {
  id                        String   @id @default(uuid())
  user_id                   String
  stripe_payment_method_id  String   @unique
  brand                     String?
  last4                     String?
  is_default                Boolean  @default(false)
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @updatedAt @db.Timestamptz(6)

  @@index([user_id])
}

// Webhook dedup keys and agent-send dispatch dedup keys share this table (§3.4 idempotency rule):
// every Stripe webhook handler and every agent-send dispatch checks `key` before acting.
model IdempotencyLog {
  id           String   @id @default(uuid())
  key          String   @unique
  source       String   // e.g. stripe_webhook | agent_dispatch
  processed_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([source])
}

// Sponsor → downline revenue-share config (§15).
model CommissionConfig {
  id                     String    @id @default(uuid())
  organization_id        String?
  sponsor_user_id        String?
  revenue_share_percent  Float     @default(0)
  effective_start        DateTime  @default(now()) @db.Timestamptz(6)
  effective_end          DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Org tree & upline invites (§6.6, §13)
// ═══════════════════════════════════════════════════════════════════════

// Recruiter → recruit edges for the org tree; Rules-of-Building computed fields are maintained by
// the application layer, not generated columns, so the "what-if" simulator (P2, §1.6) can recompute
// without a migration.
model OrgTreeEdge {
  id                    String   @id @default(uuid())
  sponsor_id            String
  recruit_id            String
  edge_type             String   // upline_sponsor | crossline | downline_rep
  is_recruit_confirmed  Boolean  @default(false)
  leg_depth             Int      @default(0)
  is_leg                Boolean  @default(false)
  has_own_recruit       Boolean  @default(false)
  health_index          Json?    // { grow, engage, wealth }
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  @@unique([sponsor_id, recruit_id])
  @@index([sponsor_id])
  @@index([recruit_id])
}

// The invite state machine (§6.6); resend_count max of 3 is an application-level invariant.
model UplineInvite {
  id              String    @id @default(uuid())
  sponsor_id      String
  recipient_email String
  status          String    @default("SENT") // SENT | PENDING | ACCEPTED | REJECTED | EXPIRED
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  responded_at    DateTime? @db.Timestamptz(6)
  resend_count    Int       @default(0) // application layer enforces max 3 (§6.6)

  @@index([sponsor_id])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Gamification (§12)
// ═══════════════════════════════════════════════════════════════════════

model MomentumEvent {
  id         String   @id @default(uuid())
  user_id    String
  event_type String
  points     Int
  law        String   // grow | engage | wealth | cross
  source_ref String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at])
}

model Milestone {
  id                  String   @id @default(uuid())
  user_id             String
  milestone_key       String
  achieved_at         DateTime @default(now()) @db.Timestamptz(6)
  celebrated          Boolean  @default(false)
  shareable_asset_ref String?

  @@unique([user_id, milestone_key])
  @@index([user_id])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Opt-out, Seven Whys, warm market, course (§6, §8, §10, §12)
// ═══════════════════════════════════════════════════════════════════════

// Global, cross-rep opt-out (§10). Queried before every send (§3.4 opt-out precedence): a match on
// (identifier_hash, channel) hard-blocks the send regardless of any other state. The unique
// constraint is the schema-level guarantee that there is exactly one authoritative row per
// identifier+channel to check against.
model OptOutRegistry {
  id              String   @id @default(uuid())
  identifier_hash String   // phone or email hash
  channel         MessageChannel
  reason          String   // stop_reply | manual | wrong_person | minor
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([identifier_hash, channel])
  @@index([identifier_hash])
}

// T-22 (§7.1 "four ingestion modalities", §18.5 "interrupted import (resumable, idempotent)") — the
// Vault's import-job checkpoint. One row per import attempt. `idempotency_key` is caller-supplied
// (the client mints one per logical import attempt, e.g. a hash of the CSV file or a UUID minted
// once and reused across retries) and is what makes re-running the same import a no-op rather than
// a duplicate: a retry with the SAME (user_id, idempotency_key) finds this row and either replays
// the cached result (already COMPLETED) or resumes from `cursor` (still IN_PROGRESS) instead of
// reprocessing rows 0..cursor. `cursor` is the zero-based index, into the caller's own row list, of
// the next row that has NOT yet been durably committed — so a crash mid-batch (partial failure)
// leaves exactly enough state to resume without corruption, data loss, or reprocessing. `error_rows`
// is the downloadable-error-rows contract (§7.6 "malformed/exotic CSV → mapping preview +
// downloadable error rows"): terminal per-row validation failures (never infra failures — those stop
// the cursor instead, see VaultService.importBatch) recorded as `[{ index, reason }]`.
//
// Referenced only loosely by `Contact.import_batch_id` (a plain scalar column, not a `@relation`),
// matching this schema's established convention (see the file-level design notes above) of avoiding
// a back-reference array on Contact for every new import-adjacent entity.
model ImportBatch {
  id                    String            @id @default(uuid())
  user_id               String
  source                String            // ContactSource value (CSV | IOS_NATIVE | ANDROID_NATIVE | GOOGLE_OAUTH)
  idempotency_key       String
  status                ImportBatchStatus @default(IN_PROGRESS)
  total_rows            Int               @default(0)
  cursor                Int               @default(0) // next unprocessed row index — the resume point
  imported_count        Int               @default(0)
  merged_count          Int               @default(0)
  minor_flagged_count   Int               @default(0)
  error_rows            Json?             // [{ index, reason }]
  created_at            DateTime          @default(now()) @db.Timestamptz(6)
  updated_at            DateTime          @updatedAt @db.Timestamptz(6)
  completed_at          DateTime?         @db.Timestamptz(6)

  @@unique([user_id, idempotency_key])
  @@index([user_id])
  @@index([user_id, status])
}

// The Seven Whys transcript + anchor (§6). The rep's anchor statement and why-photo are the most
// intimate data in the product; use_in_outreach_consent gates whether the prompt-assembly layer
// (§4.3) may ever insert them into outbound content — default false, opt-in only.
model WhySession {
  id                        String   @id @default(uuid())
  user_id                   String
  transcript                Json     // encrypted
  resonance_score           Int      @default(0) // 0–100
  anchor_statement          String?  // encrypted
  why_photo_ref             String?  // encrypted pointer
  use_in_outreach_consent   Boolean  @default(false)
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @updatedAt @db.Timestamptz(6)

  @@index([user_id])
}

// The three-layer method state (§8): Blank Canvas → Qualities Flip → Background Matching.
model WarmMarketExercise {
  id                             String   @id @default(uuid())
  user_id                        String
  blank_canvas_names             Json?
  qualities                      Json?
  background_context             Json?   // per contact
  highlights                     Json?
  match_results                  Json?
  readiness_scores               Json?
  mode                           String   @default("UNIVERSAL") // universal | primerica
  blank_canvas_completed         Boolean  @default(false)
  qualities_completed            Boolean  @default(false)
  background_matching_completed  Boolean  @default(false)
  created_at                     DateTime @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime @updatedAt @db.Timestamptz(6)

  @@index([user_id])
}

// Scaffolds the Phase-2 certification track (§1.6); v1 ships module-progress tracking only.
model CourseProgress {
  id           String    @id @default(uuid())
  user_id      String
  module_key   String
  status       String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  completed_at DateTime? @db.Timestamptz(6)

  @@unique([user_id, module_key])
}

// ═══════════════════════════════════════════════════════════════════════
// §3.3 New entities — Team calendar (§14)
