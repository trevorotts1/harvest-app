# Harvest App — Environment Variables Template
# Copy to .env.local for local development
# Add these to Vercel Dashboard > Settings > Environment Variables for production

# ─── Database ───
# PostgreSQL connection string (Supabase, Railway, Neon, or self-hosted)
DATABASE_URL="postgresql://user:password@host:5432/harvest?schema=public"

# ─── Authentication (T-04: Auth.js / NextAuth v4, D-2 confirmed) ───
# Session/JWT encryption secret (generate with: openssl rand -base64 32). NextAuth v4 reads
# NEXTAUTH_SECRET; AUTH_SECRET is the v5/Auth.js-core equivalent name — src/lib/auth/options.ts and
# middleware.ts read either, so this keeps working unmodified through a future v4→v5 migration.
# Required in any real deployment; local typecheck/build/tests in this build unit do not need it
# (no live auth flow is exercised — see T-04 build notes).
NEXTAUTH_SECRET="your-nextauth-secret-here"
AUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI / LLM Providers (Claude-only, §0.3 — no non-Claude provider key may appear here) ───
# Anthropic API key for the AI agent layer (WP04) — Haiku 4.5 / Sonnet 5 / Opus 4.8 only.
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Payment (Stripe) — WP10 ───
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── Messaging / Outreach — WP05 ───
# Convert & Flow (GoHighLevel) Private Integration Token
GHL_PIT="pit-..."

# Email delivery (SendGrid, Resend, or SES)
SMTP_HOST="smtp.sendgrid.net"
SMTP_API_KEY="SG."

# SMS delivery (Twilio)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# ─── Compliance — WP11 ───
# Optional: external compliance audit webhook
COMPLIANCE_WEBHOOK_URL=""

# Server-side pepper for keyed HMAC-SHA256 matching hashes (Contact.phone_hash/email_hash,
# OptOutRegistry.identifier_hash — §3, §3.4, §10.4). Required; hmacForMatch() fails closed
# (throws) if unset. Generate with: openssl rand -base64 32. Never commit the real value.
CONTACT_HASH_PEPPER="your-contact-hash-pepper-here"

# ─── Account security — WP11/T-12 (§16.4 "MFA secret never plaintext") ───
# AES-256 key (base64, 32 bytes) encrypting TOTP secrets at rest on User.mfa_methods.
# getMfaEncryptionKey() (src/lib/auth/env.ts) fails closed (throws) if unset. Generate with:
# openssl rand -base64 32. Never commit the real value.
MFA_ENCRYPTION_KEY="your-mfa-encryption-key-here"

# ─── Onboarding — WP01/T-20 (§3.2, §16.3 "solution number encrypted at rest") ───
# Application-layer key encrypting a declared Primerica solution number at rest on User.solution_number.
# getSolutionNumberEncryptionKey() (src/services/onboarding/wp01/solution-number.ts) fails closed
# (throws) if unset. Generate with: openssl rand -base64 32. Never commit the real value.
SOLUTION_NUMBER_ENCRYPTION_KEY="your-solution-number-encryption-key-here"

# ─── App Config ───
# Node environment
NODE_ENV="development"
